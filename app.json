{
  "expo": {
    "name": "Hammer",
    "slug": "hammer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hammer",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.hammer.customerapp",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.hammer.customerapp",
      "adaptiveIcon": {
        "backgroundColor": "#ffb502",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
